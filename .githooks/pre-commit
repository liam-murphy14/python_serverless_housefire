#!/bin/sh

set -eu

if [ "${SKIP_AGENTS_SYNC:-}" = "1" ]; then
    echo "warning: skipping AGENTS.md synchronization (SKIP_AGENTS_SYNC=1)" >&2
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
sync_script="$repo_root/scripts/sync_agents_md.py"

if [ ! -f "$sync_script" ]; then
    echo "error: missing $sync_script" >&2
    exit 1
fi

python3 "$sync_script"

cd "$repo_root"
if [ -n "$(git status --porcelain -- AGENTS.md)" ]; then
    git add -- AGENTS.md
    echo "staged refreshed AGENTS.md inventory"
fi
